# LearnLoop AI - Environment Configuration
# When GEMINI_API_KEY is provided, the application runs in Live AI Mode.
# When omitted or empty, the application seamlessly runs in Deterministic Engine Mode with zero errors.

# Google Gemini API Key
GEMINI_API_KEY=

# Preferred Model (defaults to gemini-1.5-flash or gemini-2.0-flash)
GEMINI_MODEL=gemini-1.5-flash

# Optional App Environment
NODE_ENV=development
